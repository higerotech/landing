{
  "name": "higerotech-landing",
  "version": "0.4.0",
  "private": true,
  "description": "Pruebas del sitio estatico. El sitio no se construye con npm: este paquete existe solo para ejecutar las unitarias.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "coverage": "node tests/cobertura.mjs",
