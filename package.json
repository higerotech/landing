    "dast": "node tests/dast.mjs",
    "mutacion": "stryker run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/tap-runner": "^9.6.1",
    "jsdom": "^28.0.0",
    "lighthouse": "^13.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
