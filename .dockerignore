# Control de versiones
.git
.gitignore
.gitattributes

# Documentación y metodología: no van en la imagen
*.md
docs/
.ai-dlc/
.github/

# Pruebas y sus dependencias. El Dockerfile copia archivos concretos, así que
# nunca llegarían a la imagen; se excluyen para que no viajen al daemon en el
# contexto de build — `node_modules` son miles de archivos en cada `docker build`.
node_modules/
tests/
scripts/
cloudflare/
dist/
package.json
package-lock.json
playwright.config.mjs
wrangler.jsonc
coverage/
test-results/
playwright-report/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode
.idea

# Temporales
assets/*_b64.txt
*.log
